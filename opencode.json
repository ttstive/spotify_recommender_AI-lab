{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.5-free",
  "mcp": {
    "music_recommender": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "python",
        "-m",
        "mcp_server.server"
      ],
      "enabled": true,
      "environment": {
        "MUSIC_API_BASE_URL": "http://localhost:8000/api"
      }
    }
  }
}
